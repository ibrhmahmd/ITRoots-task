@using StudentRegistrationSystem.Core.DTOs
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResources> Localizer
@model CourseDto

@{
    ViewData["Title"] = Localizer["CourseDetails"];
}

<h2>@Model.CourseName</h2>
<hr />

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Model.CourseCode - @Model.CourseName</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Localizer["CourseCode"]:</dt>
            <dd class="col-sm-9">@Model.CourseCode</dd>

            <dt class="col-sm-3">@Localizer["CourseName"]:</dt>
            <dd class="col-sm-9">@Model.CourseName</dd>

            <dt class="col-sm-3">@Localizer["CourseDescription"]:</dt>
            <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

            <dt class="col-sm-3">@Localizer["Credits"]:</dt>
            <dd class="col-sm-9">@Model.Credits</dd>

            <dt class="col-sm-3">@Localizer["Semester"]:</dt>
            <dd class="col-sm-9">@Model.Semester</dd>

            <dt class="col-sm-3">@Localizer["Year"]:</dt>
            <dd class="col-sm-9">@Model.SemesterYear</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToCourses"]</a>
    </div>
</div>
