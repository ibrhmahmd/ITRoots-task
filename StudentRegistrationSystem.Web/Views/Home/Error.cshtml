@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResources> Localizer
@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error"];
}

<h1 class="text-danger">@Localizer["ErrorTitle"]</h1>
<h2 class="text-danger">@Localizer["ErrorOccurred"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>
    @Localizer["SwappingToDevelopment"] <strong>@Localizer["Development"]</strong> @Localizer["EnvironmentWillDisplay"]
</p>
<p>
    <strong>@Localizer["DevelopmentEnvironmentWarning"]</strong>
    @Localizer["CanResultInSensitiveInfo"]
    @Localizer["ForLocalDebuggin"], @Localizer["EnableDevelopment"] <strong>@Localizer["AspNetCoreEnvironment"]</strong> @Localizer["EnvironmentVariableAndRestart"]
</p>


