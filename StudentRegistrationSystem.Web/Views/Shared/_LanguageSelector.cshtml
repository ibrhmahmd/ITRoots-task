@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Localization

@inject IHtmlLocalizer<SharedResources> Localizer
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "en";
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path.Value}{Context.Request.QueryString}";
}

<ul class="navbar-nav">
    <li class="nav-item">
        @if (currentCulture == "en")
        {
             <form id="ar-form" asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="form-horizontal" role="form">
                <input type="hidden" name="language" value="ar" />
                <button type="submit" class="nav-link btn btn-link">العربية</button>
            </form>
        }
        else
        {
             <form id="en-form" asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="form-horizontal" role="form">
                <input type="hidden" name="language" value="en" />
                <button type="submit" class="nav-link btn btn-link">English</button>
            </form>
        }
    </li>
</ul>
