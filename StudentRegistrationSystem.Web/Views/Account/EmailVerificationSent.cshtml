@{
    ViewData["Title"] = "Verification Email Sent";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white text-center">
                <h4 class="mb-0">Email Sent</h4>
            </div>
            <div class="card-body text-center">
                <p class="mb-3">A verification email has been sent to your email address.</p>
                <p class="text-muted">Please check your inbox and click the verification link to activate your account.</p>
                
                <hr class="my-4" />
                
                <a asp-action="Login" class="btn btn-primary">Back to Login</a>
            </div>
        </div>
    </div>
</div>
