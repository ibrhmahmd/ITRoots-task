@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResources> Localizer
    ViewData["Title"] = Localizer["VerificationEmailSentTitle"];
}

<div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 150px);">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white text-center">
                <h4 class="mb-0">@Localizer["EmailSentHeader"]</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-envelope-check" style="font-size: 3rem; color: #28a745;"></i>
                </div>
                <h5 class="mb-3">@Localizer["VerificationEmailSentHeader"]</h5>
                <p class="mb-3">@Localizer["VerificationEmailSentBody"]</p>
                <p class="text-muted small mb-3">
                    @Localizer["CheckInboxBody"]
                </p>
                <p class="text-muted small">
                    <strong>@Localizer["VerificationImportant"]</strong>
                </p>
                
                <hr class="my-4" />
                
                <div class="d-grid gap-2">
                    <a asp-action="Login" class="btn btn-primary">@Localizer["GoToLogin"]</a>
                    <p class="text-muted small mt-2 mb-0">
                        @Localizer["EmailNotReceived"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
