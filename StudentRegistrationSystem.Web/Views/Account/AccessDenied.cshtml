@{
    ViewData["Title"] = Localizer["Access Denied"];
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white text-center">
                <h4 class="mb-0">Access Denied</h4>
            </div>
            <div class="card-body text-center">
                <p class="mb-3">You do not have permission to access this resource.</p>
                <p class="text-muted">Please contact an administrator if you believe this is an error.</p>
                
                <hr class="my-4" />
                
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Go to Home</a>
            </div>
        </div>
    </div>
</div>

