@using StudentRegistrationSystem.Web.ViewModels.Registrations
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResources> Localizer
@model MyCoursesViewModel

@{
    ViewData["Title"] = Localizer["MyCoursesTitle"];
}

<h2 class="mb-4">@Localizer["MyRegisteredCourses"]</h2>

@if (Model.Registrations.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["CourseCode"]</th>
                    <th>@Localizer["CourseName"]</th>
                    <th>@Localizer["Credits"]</th>
                    <th>@Localizer["RegistrationDate"]</th>
                    <th>@Localizer["Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Model.Registrations)
                {
                    <tr>
                        <td>@registration.CourseCode</td>
                        <td>@registration.CourseName</td>
                        <td>@registration.Credits</td>
                        <td>@registration.RegistrationDate.ToString("MM/dd/yyyy")</td>
                        <td>
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>@Localizer["NoCoursesRegistered"]</p>
        <a asp-action="Index" asp-controller="Courses" class="btn btn-primary">@Localizer["BrowseCoursesAction"]</a>
    </div>
}
