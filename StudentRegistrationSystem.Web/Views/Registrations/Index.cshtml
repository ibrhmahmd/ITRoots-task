@using StudentRegistrationSystem.Web.ViewModels.Registrations
@model MyCoursesViewModel

@{
    ViewData["Title"] = "My Courses";
}

<h2 class="mb-4">My Registered Courses</h2>

@if (Model.Registrations.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Course Code</th>
                    <th>Course Name</th>
                    <th>Credits</th>
                    <th>Registration Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Model.Registrations)
                {
                    <tr>
                        <td>@registration.CourseCode</td>
                        <td>@registration.CourseName</td>
                        <td>@registration.Credits</td>
                        <td>@registration.RegistrationDate.ToString("MM/dd/yyyy")</td>
                        <td>
                            <span class="badge bg-success">@registration.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>You haven't registered for any courses yet.</p>
        <a asp-action="Index" asp-controller="Courses" class="btn btn-primary">Browse Courses</a>
    </div>
}
