@model CourseDetailsViewModel

@{
    ViewData["Title"] = Localizer["CourseDetails"];
}

<h2>@Localizer["CourseDetails"]</h2>
<hr />

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Model.Course.CourseCode - @Model.Course.CourseName</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Localizer["CourseId"]:</dt>
            <dd class="col-sm-9">@Model.Course.Id</dd>

            <dt class="col-sm-3">@Localizer["CourseCode"]:</dt>
            <dd class="col-sm-9">@Model.Course.CourseCode</dd>

            <dt class="col-sm-3">@Localizer["CourseName"]:</dt>
            <dd class="col-sm-9">@Model.Course.CourseName</dd>

            @if (!string.IsNullOrEmpty(Model.Course.CourseNameAr))
            {
                <dt class="col-sm-3">@Localizer["CourseNameAr"]:</dt>
                <dd class="col-sm-9">@Model.Course.CourseNameAr</dd>
            }

            <dt class="col-sm-3">@Localizer["CourseDescription"]:</dt>
            <dd class="col-sm-9">@(Model.Course.Description ?? "N/A")</dd>

            @if (!string.IsNullOrEmpty(Model.Course.DescriptionAr))
            {
                <dt class="col-sm-3">@Localizer["DescriptionAr"]:</dt>
                <dd class="col-sm-9">@Model.Course.DescriptionAr</dd>
            }

            <dt class="col-sm-3">@Localizer["Credits"]:</dt>
            <dd class="col-sm-9">@Model.Course.Credits</dd>

            <dt class="col-sm-3">@Localizer["Semester"]:</dt>
            <dd class="col-sm-9">@Model.Course.Semester</dd>

            <dt class="col-sm-3">@Localizer["Year"]:</dt>
            <dd class="col-sm-9">@Model.Course.SemesterYear</dd>

            @if (Model.Course.SemesterStartDate.HasValue)
            {
                <dt class="col-sm-3">@Localizer["SemesterStartDate"]:</dt>
                <dd class="col-sm-9">@Model.Course.SemesterStartDate.Value.ToString("MM/dd/yyyy")</dd>
            }

            <dt class="col-sm-3">@Localizer["MaxCapacity"]:</dt>
            <dd class="col-sm-9">@(Model.Course.MaxCapacity?.ToString() ?? Localizer["Unlimited"].Value)</dd>

            <dt class="col-sm-3">@Localizer["Status"]:</dt>
            <dd class="col-sm-9">
                @if (Model.Course.IsActive)
                {
                    <span class="badge bg-success">@Localizer["Active"]</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                }
            </dd>

            <dt class="col-sm-3">@Localizer["CreatedAt"]:</dt>
            <dd class="col-sm-9">@Model.Course.CreatedAt.ToString("MM/dd/yyyy HH:mm")</dd>

            @if (Model.Course.UpdatedAt.HasValue)
            {
                <dt class="col-sm-3">@Localizer["UpdatedAt"]:</dt>
                <dd class="col-sm-9">@Model.Course.UpdatedAt.Value.ToString("MM/dd/yyyy HH:mm")</dd>
            }
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Course.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> @Localizer["EditCourse"]
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Course.Id" class="btn btn-danger">
            <i class="bi bi-trash"></i> @Localizer["DeleteCourse"]
        </a>
        <a asp-action="Index" class="btn btn-secondary">@Localizer["BackToList"]</a>
    </div>
</div>
