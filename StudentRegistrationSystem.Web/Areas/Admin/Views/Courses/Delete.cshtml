@model CourseDto

@{
    ViewData["Title"] = Localizer["DeleteCourse"];
}

<h2>@Localizer["DeleteCourse"]</h2>
<hr />

<div class="alert alert-warning">
    <h4>@Localizer["DeleteCourseConfirmation"]</h4>
    <p class="mb-0">@Localizer["DeleteCourseWarning"]</p>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">@Localizer["CourseInformation"]</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Localizer["CourseCode"]:</dt>
            <dd class="col-sm-9">@Model.CourseCode</dd>

            <dt class="col-sm-3">@Localizer["CourseName"]:</dt>
            <dd class="col-sm-9">@Model.CourseName</dd>

            <dt class="col-sm-3">@Localizer["CourseDescription"]:</dt>
            <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

            <dt class="col-sm-3">@Localizer["Credits"]:</dt>
            <dd class="col-sm-9">@Model.Credits</dd>

            <dt class="col-sm-3">@Localizer["Semester"]:</dt>
            <dd class="col-sm-9">@Model.Semester</dd>

            <dt class="col-sm-3">@Localizer["Year"]:</dt>
            <dd class="col-sm-9">@Model.SemesterYear</dd>

            <dt class="col-sm-3">@Localizer["Status"]:</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">@Localizer["Active"]</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> @Localizer["DeleteCourse"]
    </button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
</form>
