@model CourseDto

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>
<hr />

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this course?</h4>
    <p class="mb-0">This action cannot be undone. The course will be marked as inactive.</p>
</div>

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Course Information</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Course Code:</dt>
            <dd class="col-sm-9">@Model.CourseCode</dd>

            <dt class="col-sm-3">Course Name:</dt>
            <dd class="col-sm-9">@Model.CourseName</dd>

            <dt class="col-sm-3">Description:</dt>
            <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>

            <dt class="col-sm-3">Credits:</dt>
            <dd class="col-sm-9">@Model.Credits</dd>

            <dt class="col-sm-3">Semester:</dt>
            <dd class="col-sm-9">@Model.Semester</dd>

            <dt class="col-sm-3">Semester Year:</dt>
            <dd class="col-sm-9">@Model.SemesterYear</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Delete Course
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
