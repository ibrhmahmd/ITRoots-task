@using StudentRegistrationSystem.Core.DTOs
@using StudentRegistrationSystem.Domain.Common
@model PagedResult<CourseDto>

@{
    ViewData["Title"] = Localizer["CoursesManagement"];
    var currentPage = Model.PageNumber;
    var pageSize = Model.PageSize;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Localizer["CoursesManagement"]</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> @Localizer["AddCourse"]
    </a>
</div>

@* Page Size Selector *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <form method="get" class="d-inline-flex align-items-center">
            <label for="pageSize" class="me-2">@Localizer["Show"]:</label>
            <select name="pageSize" id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                <option value="10" selected="@(pageSize == 10)">10</option>
                <option value="25" selected="@(pageSize == 25)">25</option>
                <option value="50" selected="@(pageSize == 50)">50</option>
                <option value="100" selected="@(pageSize == 100)">100</option>
            </select>
            <input type="hidden" name="page" value="1" />
            @foreach (var key in Context.Request.Query.Keys)
            {
                @if (key != "pageSize" && key != "page")
                {
                    <input type="hidden" name="@key" value="@Context.Request.Query[key]" />
                }
            }
        </form>
    </div>
    <div>
        <small class="text-muted">@Localizer["Total"]: @Model.TotalCount @Localizer["Courses"]</small>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>@Localizer["Id"]</th>
                <th>@Localizer["CourseCode"]</th>
                <th>@Localizer["CourseName"]</th>
                <th>@Localizer["CourseDescription"]</th>
                <th>@Localizer["Credits"]</th>
                <th>@Localizer["Semester"]</th>
                <th>@Localizer["Year"]</th>
                <th>@Localizer["MaxCapacity"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model.Items)
            {
                <tr>
                    <td>@course.Id.Substring(0, 8)...</td>
                    <td>@course.CourseCode</td>
                    <td>@course.CourseName</td>
                    <td>@(course.Description?.Length > 50 ? course.Description.Substring(0, 50) + "..." : course.Description ?? "N/A")</td>
                    <td>@course.Credits</td>
                    <td>@course.Semester</td>
                    <td>@course.SemesterYear</td>
                    <td>@(course.MaxCapacity?.ToString() ?? Localizer["Unlimited"].Value)</td>
                    <td>
                        @if (course.IsActive)
                        {
                            <span class="badge bg-success">@Localizer["Active"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-info" title="@Localizer["Details"]">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-warning" title="@Localizer["Edit"]">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger" title="@Localizer["Delete"]">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        <p class="mb-0">@Localizer["NoCoursesFound"] <a asp-action="Create">@Localizer["CreateFirstCourse"]</a>.</p>
    </div>
}

@* Pagination *@
@if (Model.TotalPages > 1)
{
    <div class="mt-4">
        @await Html.PartialAsync("_Pagination", Model)
    </div>
}
